# Application
NODE_ENV=development
PORT=3000
APP_NAME=SpartaGuardia Backend

# Database
DATABASE_URL=postgresql://spartaguardia:spartaguardia@localhost:5432/spartaguardia
DB_HOST=localhost
DB_PORT=5432
DB_USER=spartaguardia
DB_PASSWORD=spartaguardia
DB_NAME=spartaguardia

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Weather Integration
WEATHER_API_URL=https://api.bmkg.go.id/v2
WEATHER_FETCH_INTERVAL_HOURS=3

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=spartaguardia-reports
STORAGE_S3_REGION=us-east-1

# Risk Calculation (Configurable Weights)
RISK_RAINFALL_WEIGHT=0.2
RISK_SLOPE_WEIGHT=0.2
RISK_RIVER_DISTANCE_WEIGHT=0.15
RISK_HISTORY_WEIGHT=0.15
RISK_REPORT_WEIGHT=0.3

# Violation Detection
VIOLATION_RISK_THRESHOLD=60
VIOLATION_REPORT_THRESHOLD=3
VIOLATION_ZONE_TYPE=lindung

# Logging
LOG_LEVEL=debug
LOG_FORMAT=simple

# CORS
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true
